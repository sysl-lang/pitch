module sh.sysl.pitch

import sysl.math.{Float, clamp, max}

/** Why a detector or a filter could not be made, or a detector could not look at a frame. */
enum Fault
    /** The sample rate was not a positive, finite number. */
    BadRate
    /** The range was empty, not positive, or reached so close to the sample rate that a period would
     * be shorter than two samples — too short to have a dip with a neighbour on either side.
     */
    BadRange
    /** The frame was shorter than the detector needs; the payload is how many samples it does need. */
    TooShort(needed: usize)
    /** A filter's cutoff was not between zero and half the sample rate, both exclusive. */
    BadCutoff
    /** A filter was asked for no sections at all, which would filter nothing. */
    NoSections

    describe(self) -> string = self match
        BadRate -> "the sample rate must be a positive, finite number of samples per second"
        BadRange -> "the range must satisfy 0 < lowest < highest <= a quarter of the sample rate"
        TooShort(n) -> f"a frame must hold at least $n samples: two periods of the lowest frequency"
        BadCutoff -> "the cutoff must satisfy 0 < cutoff < half the sample rate"
        NoSections -> "a filter needs at least one section"
end Fault

/** What a detector heard in one frame.
 *
 * `clarity` is one minus the depth of the dip the period was read from, so a perfectly periodic frame
 * scores 1 and a frame that only just passed the threshold scores a little under `1 - threshold`.
 */
struct Estimate[F: Float]
    frequency: F
    clarity: F

/** A YIN pitch detector: one sample rate, one range of frequencies, reused for every frame.
 *
 * YIN (de Cheveigné and Kawahara, 2002) reads the period straight off the signal: it asks how much
 * the frame differs from itself shifted by each candidate lag, normalises that by its own running
 * mean, and takes the first lag where the difference falls below `threshold`. Because the question is
 * "where does the waveform repeat" rather than "which frequency is loudest", a tone whose second
 * harmonic outweighs its fundamental — a plucked string — still reads at its fundamental.
 *
 * The detector owns the buffer the difference function is written into, sized once from the range,
 * so `detect` allocates nothing however many frames it is given.
 */
struct Detector[F: Float]
    private rate: F
    private lowest: F
    private highest: F
    private longest: usize
    private diff: []F

    /** How deep a dip has to be, as a fraction of the running mean, to count as a period. Lower is
     * stricter: fewer octave errors on noisy input, more frames answered with `None`.
     */
    threshold: F

    /** The root-mean-square level below which a frame is silence rather than a tone. */
    gate: F

    /** The fewest samples `detect` accepts: two periods of the lowest frequency, so that every
     * candidate lag is compared over at least one whole period.
     */
    frame_len(self) -> usize = 2 * (self.longest + 1)

    /** The period of one frame, as a frequency in Hz, or `None` where the frame is quieter than
     * `gate`, has no dip below `threshold`, or repeats at a frequency outside the range.
     *
     * Every sample handed over is used; a longer frame averages over more periods and costs
     * proportionally more.
     */
    detect(*self, samples: []const F) -> Result[Option[Estimate[F]], Fault]
        val needed = self.frame_len()

        if samples.len < needed then return Err(TooShort(needed))

        if rms(samples) < self.gate then return Ok(None)

        difference(samples, self.diff)
        normalise(self.diff)

        Ok(self.period(samples))
    end detect

    // The first dip of the normalised difference below the threshold, followed down to its floor and
    // read to a fraction of a sample from the raw difference beside it.
    private period(*self, samples: []const F) -> Option[Estimate[F]]
        val last = self.diff.len - 1
        var lag = first_below(self.diff, self.threshold)?

        while lag < last && self.diff[lag + 1] < self.diff[lag]
            lag += 1

        // Still falling at the last lag measured: the floor lies past the lowest frequency.
        if lag == last then return None

        val depth = self.diff[lag]
        val shift = vertex(raw(samples, lag - 1, last), raw(samples, lag, last), raw(samples, lag + 1, last))
        val frequency = self.rate / (F(lag) + shift)

        if frequency < self.lowest || frequency > self.highest then return None

        Some(Estimate(frequency, max(F.one() - depth, F.zero())))
    end period
end Detector

/** A detector for `rate` samples a second, listening between `lowest` and `highest` Hz.
 *
 * `threshold` starts at 0.12, inside the 0.10–0.15 band the YIN paper found reliable, and `gate` at
 * 0.001 — sixty decibels below a full-scale sine. Both are fields, and may be set afterwards.
 */
detector[F: Float](rate: F, lowest: F, highest: F) -> Result[Detector[F], Fault]
    if !(rate > F.zero()) || !rate.is_finite() then return Err(BadRate)

    if !(lowest > F.zero()) || !(highest > lowest) || highest * F(4) > rate then return Err(BadRange)

    val longest = usize((rate / lowest).ceil())

    Ok(Detector(rate, lowest, highest, longest, [F.zero(); longest + 2], 0.12, 0.001))
end detector

/** The root-mean-square level of a frame. */
rms[F: Float](samples: []const F) -> F
    var total = F.zero()

    for x in samples do total += x * x

    (total / F(samples.len)).sqrt()
end rms

// d(lag) = the sum over a fixed window of (x[j] - x[j + lag])^2, for every lag the buffer holds. The
// window is the frame less the longest lag, so every lag is compared over the same number of samples.
private difference[F: Float](samples: []const F, d: []F)
    val window = samples.len - (d.len - 1)

    d[0] = F.zero()

    for lag in 1..<d.len
        var total = F.zero()

        for j in 0..<window
            val delta = samples[j] - samples[j + lag]
            total += delta * delta

        d[lag] = total
end difference

// The cumulative mean normalised difference, in place: d'(0) = 1, and d'(lag) = d(lag) divided by the
// mean of d over 1..lag. A lag shorter than the period lands near or above one, so the first dip
// below the threshold is the period and not a lag of zero.
private normalise[F: Float](d: []F)
    var running = F.zero()

    d[0] = F.one()

    for lag in 1..<d.len
        running += d[lag]
        d[lag] = if running > F.zero() then d[lag] * F(lag) / running else F.one()
end normalise

// The first lag of two or more whose normalised difference is below the threshold.
private first_below[F: Float](d: []const F, threshold: F) -> Option[usize]
    for lag in 2..<d.len do if d[lag] < threshold then return Some(lag)

    None

// The raw difference at one lag, over the same window `difference` used, which the normalised one
// has overwritten.
private raw[F: Float](samples: []const F, lag: usize, last: usize) -> F
    val window = samples.len - last
    var total = F.zero()

    for j in 0..<window
        val delta = samples[j] - samples[j + lag]
        total += delta * delta

    total
end raw

// Where the parabola through three equally spaced values bottoms out, as an offset from the middle
// one, kept within the two neighbours.
private vertex[F: Float](a: F, b: F, c: F) -> F
    val curve = a - b * F(2) + c

    if !(curve > F.zero()) then return F.zero()

    clamp((a - c) / (curve * F(2)), -F.one(), F.one())
end vertex
